class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        // Initialize two pointers: 'i' for the position to place the next non-zero element
        // and 'j' to traverse the array.
        int i = 0;
        int j = 0;

        // Iterate through the array until 'j' reaches the end.
        while (j < nums.size()) {
            // If the current element is not zero, swap it with the element at index 'i'.
            if (nums[j] != 0) {
                // Perform the swap to move the non-zero element to the correct position.
                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;

                // Move the 'i' pointer to the next position for the next non-zero element.
                i++;
            }
            // Increment the 'j' pointer to continue traversing the array.
            j++;
        }
    }
};
